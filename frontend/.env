# Config del frontend cuando se arranca con docker compose up.
# docker-compose.yml carga este fichero literalmente (env_file).
# Si quieres trabajar con npm run dev directamente desde el host,
# usa frontend/.env.local en su lugar (lo cargará Vite, no Compose).

# Vacío para usar el proxy de Vite (evita CORS).
VITE_API_URL=

# Dentro de la red de docker-compose el backend no es localhost,
# es el nombre del servicio: backend.
VITE_API_PROXY_TARGET=http://backend:8000

# Clave compartida con el backend. Debe coincidir con API_KEY_VALUE
# en backend/.env. Sin esto las peticiones reciben 401.
VITE_API_KEY=12ao.9-8a7b-4c&d-9e,f-?89abc

# Backend real activo → no usar mocks.
VITE_USE_MOCKS=false