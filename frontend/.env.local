# Override local para `npm run dev` desde el host (Vite lo carga
# automáticamente; docker-compose lo ignora, ese usa frontend/.env).

# Dev: dejamos VITE_API_URL en blanco para usar el proxy de Vite
# (ver vite.config.js). Así evitamos problemas de CORS mientras el
# backend no tenga CORSMiddleware configurado.
VITE_API_URL=

# Destino al que Vite reenvía las peticiones del proxy (host local).
VITE_API_PROXY_TARGET=http://localhost:8000

# Clave compartida con el backend. Debe coincidir con `API_KEY_VALUE`
# en backend/.env. Sin esto las peticiones reciben 401.
VITE_API_KEY=12ao.9-8a7b-4c&d-9e,f-?89abc

# Backend real activo → no usar mocks.
VITE_USE_MOCKS=false
